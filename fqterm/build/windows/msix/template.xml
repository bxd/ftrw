<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="fqterm.exe"
        Arguments=""
        InstallLocation="C:\Program Files\FQTerm\FQTerm">
    </Installer>
    <PackageInformation
        PackageName="FQTerm"
        PackageDisplayName="FQTerm"
        PublisherName="CN=FQTerm"
        PublisherDisplayName="FQTerm"
        Version="0.4.1.0"
        PackageDescription="Telnet/SSH BBS Terminal">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="org.fqterm.app"
                Description="Telnet/SSH BBS Terminal"
                DisplayName="FQTerm"
                ExecutableName="fqterm.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>FQTerm</DisplayName>
            <PublisherDisplayName>FQTerm</PublisherDisplayName>
            <Description>Telnet/SSH BBS Terminal</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="fqterm.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
